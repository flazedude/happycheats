<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><StartupObject>HappyCheats.Tests.Program</StartupObject><NoWarn>$(NoWarn);CA1416</NoWarn></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/HappyCheats.Core/HappyCheats.Core.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../CheatPluginFixture/CheatPluginFixture.csproj" ReferenceOutputAssembly="false" /><Compile Include="../CheatTestSupport.cs" Link="CheatTestSupport.cs" /></ItemGroup>
  <Target Name="CopyCheatFixture" AfterTargets="Build"><MakeDir Directories="$(OutDir)fixtures" /><Copy SourceFiles="../CheatPluginFixture/bin/$(Configuration)/net8.0/HappyCheats.Core.dll" DestinationFiles="$(OutDir)fixtures/FutureGame.dll" /></Target>
  <ItemGroup><Compile Include="../../src/HappyCheats.App/ControllerInput.cs" Link="ControllerInput.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../../src/HappyCheats.Updater/UpdateInstaller.cs" Link="UpdateInstaller.cs" /></ItemGroup>
</Project>
