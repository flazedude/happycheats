<Window x:Class="HappyCheats.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HappyCheats" Width="1180" Height="820" MinWidth="800" MinHeight="480"
        Icon="Assets/Branding/HappyCheats.png"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource InkBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        PreviewKeyDown="WindowKeyDown">
  <Window.Resources>
    <Style x:Key="LibrarySortButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="MinWidth" Value="48"/><Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="sortChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7,5">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SelectionInkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sortChrome" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="sortChrome" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="sortChrome" Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="FeatureRowTemplate">
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="12,8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="108"/>
            <ColumnDefinition Width="84"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="FeatureHeading" MinHeight="36" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="FeatureDescription" Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
              <TextBlock.ToolTip><ToolTip MaxWidth="420"><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/></ToolTip></TextBlock.ToolTip>
            </TextBlock>
          </StackPanel>
          <StackPanel x:Name="FeatureOptions" Grid.Column="1" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Choices}" Visibility="{Binding ChoicesVisibility}" ToolTip="{Binding ChoiceCaption}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding Label}" Click="FeatureChoiceClicked" Tag="{Binding}" IsEnabled="{Binding CanUse}"
                        Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" Foreground="{Binding Foreground}"
                        Padding="8,6" Margin="4,0,0,0" MinWidth="57" FontSize="11"/>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Width="178" Visibility="{Binding NumberVisibility}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanUse}" MaxLength="32"
                         AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding NumberHint}"
                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource StrongLineBrush}" CaretBrush="{DynamicResource InkBrush}" Padding="8,4" FontSize="12"
                         MinHeight="44" VerticalContentAlignment="Center" ToolTip="{Binding NumberHint}" ToolTipService.ShowOnDisabled="True"/>
                <TextBlock Grid.Column="1" Text="{Binding NumberUnit}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="7,0,0,0"/>
              </Grid>
              <TextBlock Text="{Binding ConfirmedNumberLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding ConfirmedNumberVisibility}"/>
            </StackPanel>
          </StackPanel>
          <Border x:Name="FeatureHotkey" Grid.Column="2" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource SelectionBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HotkeyVisibility}">
            <TextBlock Text="{Binding Hotkey}" Foreground="{DynamicResource SelectionInkBrush}" FontSize="9" FontWeight="SemiBold"/>
          </Border>
          <TextBlock x:Name="FeatureState" Grid.Column="3" Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontSize="10"
                     VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
          <Button x:Name="FeatureAction" Grid.Column="4" Content="{Binding ActionLabel}" Click="FeatureClicked" Tag="{Binding}" IsEnabled="{Binding CanUse}"
                  AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" Padding="10,6" FontSize="11"
                  Background="{Binding ActionBrush}" BorderBrush="{Binding ActionBorderBrush}"/>
          <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="{Binding NumberError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                     TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding NumberErrorVisibility}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="FeatureHeading" Property="Grid.ColumnSpan" Value="5"/>
          <Setter TargetName="FeatureHeading" Property="Margin" Value="0,0,0,8"/>
          <Setter TargetName="FeatureDescription" Property="TextWrapping" Value="Wrap"/>
          <Setter TargetName="FeatureOptions" Property="Grid.Row" Value="1"/>
          <Setter TargetName="FeatureOptions" Property="Grid.Column" Value="0"/>
          <Setter TargetName="FeatureOptions" Property="Grid.ColumnSpan" Value="2"/>
          <Setter TargetName="FeatureOptions" Property="HorizontalAlignment" Value="Left"/>
          <Setter TargetName="FeatureHotkey" Property="Grid.Row" Value="1"/>
          <Setter TargetName="FeatureState" Property="Grid.Row" Value="1"/>
          <Setter TargetName="FeatureAction" Property="Grid.Row" Value="1"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="PageMargins" TargetType="StackPanel">
      <Setter Property="Margin" Value="34,0,22,25"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout}" Value="True"><Setter Property="Margin" Value="16,0,12,20"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="HeaderMargins" TargetType="Grid">
      <Setter Property="Margin" Value="34,0,34,0"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout}" Value="True"><Setter Property="Margin" Value="16,0,16,0"/></DataTrigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootSurface" Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="12,20,12,12">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="58"/><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
          <Image Source="Assets/Branding/HappyCheats.png" Width="40" Height="40" Margin="0,0,6,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="HappyCheats"/>
          <StackPanel Margin="0,3,0,0"><TextBlock Text="HappyCheats" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Labels[tagline]}" Foreground="{DynamicResource MutedBrush}" FontSize="7.9" Margin="1,3,0,0"/></StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Height="44" VerticalAlignment="Top" Background="{DynamicResource InputBrush}" CornerRadius="7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
          <Grid Margin="11,0"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <Grid Grid.Column="1"><TextBox x:Name="SearchBox" TextChanged="SearchChanged" IsEnabled="{Binding CanManage}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}" VerticalContentAlignment="Center" FontSize="12" Padding="0"/>
              <TextBlock Text="{Binding Labels[search]}" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="2">
          <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="44"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Labels[yourLibrary]}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
          <TextBlock Text="{Binding Games.Count, StringFormat=00}" HorizontalAlignment="Right" Foreground="{DynamicResource SubtleBrush}" FontSize="10"/>
          <Grid Grid.Row="1" ToolTip="{Binding Labels[sortHint]}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Labels[sortBy]}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <RadioButton x:Name="SortAscendingButton" Grid.Column="1" Content="A–Z" Tag="az" GroupName="LibrarySort" Style="{StaticResource LibrarySortButton}" Margin="0,0,4,0"
                         IsChecked="{Binding LibrarySortAscending, Mode=OneWay}" IsEnabled="{Binding CanManage}" Checked="LibrarySortChanged"
                         AutomationProperties.Name="{Binding Labels[sortAscending]}" AutomationProperties.HelpText="{Binding Labels[sortHint]}"/>
            <RadioButton x:Name="SortDescendingButton" Grid.Column="2" Content="Z–A" Tag="za" GroupName="LibrarySort" Style="{StaticResource LibrarySortButton}"
                         IsChecked="{Binding LibrarySortDescending, Mode=OneWay}" IsEnabled="{Binding CanManage}" Checked="LibrarySortChanged"
                         AutomationProperties.Name="{Binding Labels[sortDescending]}" AutomationProperties.HelpText="{Binding Labels[sortHint]}"/>
          </Grid>
        </Grid>
        <ListBox x:Name="Library" Grid.Row="3" ItemsSource="{Binding Games}" IsEnabled="{Binding CanManage}" SelectionChanged="GameSelected" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource InkBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" ScrollViewer.PanningMode="VerticalOnly" Padding="0">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="item" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="10,12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="item" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="item" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="{DynamicResource ArtworkBrush}" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center"><Image Source="{Binding IconUri}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Name}"/></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding LibraryDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="2,10,0,0">
          <StackPanel>
            <Button Click="UpdatesClicked" IsEnabled="{Binding CanManage}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="11,9">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Labels[updates]}" FontSize="11"/><Border Grid.Column="1" Background="{DynamicResource SelectionBrush}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" Visibility="{Binding UpdateBadgeVisibility}"><TextBlock Text="{Binding UpdateBadgeLabel}" FontSize="8" Foreground="{DynamicResource SelectionInkBrush}"/></Border></Grid>
            </Button>
            <TextBlock Text="{Binding ClientVersionLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="11,9,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="61"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Style="{StaticResource HeaderMargins}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Selected.Name}" Foreground="{DynamicResource InkBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ThemeToggleButton" Content="{Binding ThemeToggleLabel}" Click="ThemeClicked"
                  ToolTip="{Binding ThemeToggleHint}" AutomationProperties.Name="{Binding ThemeToggleHint}"
                  Style="{StaticResource QuietButton}" MinWidth="84" Margin="0,0,10,0" Padding="10,4" FontSize="11"/>
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="2"><StackPanel Orientation="Horizontal">
            <Button Content="中文" Tag="zh" Click="LanguageClicked" Padding="9,4" FontSize="10" Background="{Binding ChineseLanguageBrush}" BorderThickness="0" Foreground="{Binding ChineseLanguageInk}"/>
            <Button Content="English" Tag="en" Click="LanguageClicked" Padding="9,4" FontSize="10" Background="{Binding EnglishLanguageBrush}" BorderThickness="0" Foreground="{Binding EnglishLanguageInk}"/>
          </StackPanel></Border>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False" Padding="0,0,8,0">
        <StackPanel Style="{StaticResource PageMargins}">
          <Border CornerRadius="9" BorderBrush="{DynamicResource SelectionBorderBrush}" BorderThickness="1" Padding="16,14" Background="{DynamicResource HeroBrush}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="STEAM /" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SelectionInkBrush}" Margin="0,0,9,0"/><TextBlock Grid.Column="1" Text="{Binding Selected.Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/></Grid>
                <TextBlock Text="{Binding Selected.Name}" FontSize="25" FontWeight="SemiBold" Margin="-1,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Selected.HeroLine}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="16"/>
              </StackPanel>
              <Border Grid.Column="1" VerticalAlignment="Center" Padding="8" Background="{DynamicResource ArtworkBrush}" CornerRadius="8">
                <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="156"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout}" Value="True"><Setter Property="Width" Value="112"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Image Source="{Binding Selected.LogoUri}" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Selected.Name}"/>
              </Border>
            </Grid>
          </Border>
          <Grid Margin="0,10,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <WrapPanel><Button Content="{Binding LaunchLabel}" Style="{StaticResource GoldButton}" Click="LaunchClicked" IsEnabled="{Binding CanLaunch}" Padding="16,8"/><Button Content="{Binding InstallLabel}" Style="{StaticResource QuietButton}" Click="InstallClicked" IsEnabled="{Binding CanInstall}" Padding="16,8" Margin="9,0,0,0"/></WrapPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.Column" Value="1"/><Setter Property="HorizontalAlignment" Value="Right"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,10,0,0"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <Ellipse Width="6" Height="6" Fill="{Binding ConnectionBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionBrush}" FontSize="11"/>
            </StackPanel>
          </Grid>
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Labels[controls]}" FontSize="21" FontWeight="SemiBold"/><Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Padding="6,2" Margin="11,4,0,3"><TextBlock Text="{Binding FeatureCount}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></Border></StackPanel><TextBlock Text="{Binding ControlsHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="{Binding Labels[disableAll]}" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanDisableAll}" Click="DisableAllClicked" Padding="13,8" VerticalAlignment="Top" Margin="15,2,0,0"/></Grid>
          </Border>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,14,0,0">
            <StackPanel>
              <Button x:Name="GameMenuButton" Content="{Binding OverlayLabel}" Click="OverlayClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="10,8" FontSize="12"/>
              <TextBlock Text="{Binding OverlayHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,7,2,0"/>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Features}" ItemTemplate="{StaticResource FeatureRowTemplate}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="17,15" Margin="0,18,0,0" Visibility="{Binding ControllerVisibility}">
            <StackPanel><WrapPanel><CheckBox Content="{Binding Labels[xbox]}" IsChecked="{Binding ControllerEnabled}" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="SemiBold" MinHeight="44" VerticalContentAlignment="Center" Margin="0,0,16,0"/><TextBlock Text="{Binding ControllerLabel}" Foreground="{DynamicResource SuccessBrush}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
              <TextBlock Text="{Binding ControllerDirections}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ControllerBumpers}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Labels[controllerHint]}" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding ValuesLine}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,13,0,0" Visibility="{Binding ValuesVisibility}"/>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="17,16" Margin="0,20,0,0">
            <StackPanel><Grid><TextBlock Text="{Binding Labels[installation]}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding InstallationLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding InstallationPath}" Foreground="{DynamicResource InkBrush}" FontFamily="Consolas" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding BuildLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/><Grid Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Button Content="{Binding Labels[browse]}" Click="BrowseClicked" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanManage}" Padding="11,7" FontSize="10"/><Button Content="{Binding Labels[scan]}" Click="RescanClicked" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanManage}" Padding="11,7" FontSize="10" Margin="8,0,0,0"/></StackPanel><Button Content="{Binding RemoveLabel}" Click="RemoveClicked" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanRemove}" HorizontalAlignment="Right" Padding="11,7" FontSize="10"/></Grid></StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,10">
        <ScrollViewer MaxHeight="68" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="{Binding MessageBrush}" VerticalAlignment="Top" Margin="0,6,0,0"/><TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding MessageBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17"/></Grid></ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
