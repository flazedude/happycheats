<Window x:Class="HappyCheats.App.CheatUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="740" Height="760" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="{Binding WindowTitle}" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Introduction}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding FocusReason}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock x:Name="UpdateStatus" Text="{Binding Status}" TextWrapping="Wrap"/>
        <ProgressBar x:Name="CheatProgressBar" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100"
                     Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" AutomationProperties.Name="{Binding Status}">
          <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></ProgressBar.Style>
        </ProgressBar>
        <TextBlock x:Name="CheatProgressDetails" Text="{Binding ProgressDetails}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Versions}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
              <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"/>
            </StackPanel>
            <Button Content="{Binding ActionLabel}" Click="GameUpdateClicked" Tag="{Binding}" Grid.Column="1" MinHeight="44" MinWidth="88" Padding="12,6" VerticalAlignment="Top" AutomationProperties.Name="{Binding AccessibleAction}"/>
          </Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="3" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="{Binding CopyLogLabel}" Click="CopyLogClicked" Padding="8,4" MinHeight="32"/>
          <TextBlock Text="{Binding LogLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="CheatActivityLog" Grid.Row="1" Text="{Binding ActivityLog, Mode=OneWay}" IsReadOnly="True" Height="110"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" TextChanged="LogTextChanged"
                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource InkBrush}" BorderThickness="0"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" AutomationProperties.Name="{Binding LogLabel}"/>
      </Grid>
    </Border>
    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CheckCheatsButton" Content="{Binding CheckLabel}" Click="CheckClicked" MinHeight="44" Padding="12,6" Margin="0,0,8,0"/>
    </WrapPanel>
  </Grid>
</Window>
