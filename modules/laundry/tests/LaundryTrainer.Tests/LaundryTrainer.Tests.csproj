<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../LaundryTrainer/GameBindings.cs" Link="Core/GameBindings.cs" />
    <Compile Include="../../LaundryTrainer/WashSpeed.cs" Link="Core/WashSpeed.cs" />
    <PackageReference Include="HarmonyX" Version="2.10.2" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="22.7.31.1" />
  </ItemGroup>
</Project>
